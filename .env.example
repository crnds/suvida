# Local development. Copy to .env and fill in.
#
# NEVER run `vercel env pull` into this project: Production, Preview and
# Development all share ONE Turso database, so pulling would point local dev
# at the database real students and teachers use. Local dev uses a file.
TURSO_DATABASE_URL=file:local.db

# Only needed against Turso Cloud, not for file:local.db.
# On Vercel this must be the https:// form of the URL, never libsql:// —
# libsql:// opens a WebSocket a serverless invocation has no business holding.
# TURSO_DATABASE_URL=https://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Bootstrap credentials for scripts/seed.js, which creates the platform owner.
# seed.js is idempotent: against a database that already has an owner it
# no-ops rather than resetting the password.
OWNER_USERNAME=owner
OWNER_PASSWORD=change-me
